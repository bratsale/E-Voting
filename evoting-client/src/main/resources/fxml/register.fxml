<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="12.0" prefWidth="520.0" prefHeight="650.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.etf.evoting.client.controller.RegisterController">
    <padding>
        <Insets bottom="25.0" left="35.0" right="35.0" top="25.0" />
    </padding>

    <Label text="Registracija Novog Korisnika">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <Separator prefWidth="200.0" />

    <GridPane vgap="10.0" hgap="10.0" alignment="CENTER">
        <!-- Tip korisnika -->
        <Label text="Tip naloga:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <HBox spacing="15.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <RadioButton fx:id="voterRadio" text="Glasač" selected="true" onAction="#handleRoleChange" />
            <RadioButton fx:id="organizerRadio" text="Organizator" onAction="#handleRoleChange" />
        </HBox>

        <!-- Zajednička polja -->
        <Label text="Korisničko ime:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="usernameField" promptText="Unesite username" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Lozinka:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <PasswordField fx:id="passwordField" promptText="Unesite lozinku" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <!-- Polja za Glasača -->
        <Label fx:id="firstNameLabel" text="Ime:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="firstNameField" promptText="Unesite ime" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label fx:id="lastNameLabel" text="Prezime:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="lastNameField" promptText="Unesite prezime" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <!-- Polja za Organizatora -->
        <Label fx:id="orgNameLabel" text="Naziv organizacije:" GridPane.columnIndex="0" GridPane.rowIndex="5" visible="false" managed="false"/>
        <TextField fx:id="orgNameField" promptText="Npr. ETF Banja Luka" GridPane.columnIndex="1" GridPane.rowIndex="5" visible="false" managed="false"/>

        <Label fx:id="orgIdLabel" text="Identifikacioni broj:" GridPane.columnIndex="0" GridPane.rowIndex="6" visible="false" managed="false"/>
        <TextField fx:id="orgIdField" promptText="Npr. ORG-12345" GridPane.columnIndex="1" GridPane.rowIndex="6" visible="false" managed="false"/>
    </GridPane>

    <Label fx:id="errorLabel" textFill="RED" visible="false" wrapText="true" />
    <Label fx:id="successLabel" textFill="GREEN" visible="false" wrapText="true" />

    <Button fx:id="registerButton" onAction="#handleRegister" prefWidth="180.0" style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold;" text="Registruj se" />
    <Hyperlink text="Već imate nalog? Prijavite se" onAction="#handleBackToLogin" />
</VBox>