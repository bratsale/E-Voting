<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" prefWidth="500.0" prefHeight="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.etf.evoting.client.controller.CreateElectionController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label text="Kreiranje Novog Glasanja">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <Label text="Naziv glasanja:" />
    <TextField fx:id="titleField" promptText="npr. Izbori za Studentski Parlament 2026" />

    <Label text="Opis:" />
    <TextArea fx:id="descriptionArea" prefHeight="80.0" promptText="Kratak opis glasanja..." wrapText="true" />

    <HBox spacing="15.0">
        <VBox HBox.hgrow="ALWAYS" spacing="5.0">
            <Label text="Datum početka:" />
            <DatePicker fx:id="startDatePicker" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS" spacing="5.0">
            <Label text="Datum završetka:" />
            <DatePicker fx:id="endDatePicker" />
        </VBox>
    </HBox>

    <Label text="Opcije / Kandidati (dodajte bar 2 opcije):" />
    <HBox spacing="10.0">
        <TextField fx:id="optionInputField" HBox.hgrow="ALWAYS" promptText="Ime kandidata ili opcija" />
        <Button text="Dodaj" onAction="#handleAddOption" style="-fx-background-color: #1976D2; -fx-text-fill: white;" />
    </HBox>

    <ListView fx:id="optionsListView" prefHeight="120.0" />

    <Label fx:id="errorLabel" textFill="RED" visible="false" wrapText="true" />

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button text="Otkaži" onAction="#handleCancel" />
        <Button text="Kreiraj Glasanje" onAction="#handleCreateElection" style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold;" />
    </HBox>
</VBox>