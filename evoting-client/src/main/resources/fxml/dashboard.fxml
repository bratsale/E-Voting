<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.etf.evoting.client.controller.DashboardController" prefHeight="600.0" prefWidth="800.0">
    <top>
        <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-background-color: #1976D2; -fx-padding: 15px;">
            <Label fx:id="userInfoLabel" text="Dobrodošli, User" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleLogout" style="-fx-background-color: #D32F2F; -fx-text-fill: white;" text="Odjava" />
        </HBox>
    </top>

    <center>
        <VBox spacing="15.0">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
            <Label text="Aktivna glasanja">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
            <TableView fx:id="electionsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="titleColumn" text="Naziv glasanja" prefWidth="250.0"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="120.0"/>
                    <TableColumn fx:id="actionColumn" text="Akcija" prefWidth="150.0"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>