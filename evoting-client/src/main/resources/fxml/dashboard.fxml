<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.etf.evoting.client.controller.DashboardController" prefHeight="600.0" prefWidth="800.0">
    <top>
        <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-background-color: #1976D2; -fx-padding: 15px;">
            <Label fx:id="userInfoLabel" text="Dobrodošli, User" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleLogout" style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-cursor: hand;" text="Odjava" />
        </HBox>
    </top>

    <center>
        <VBox spacing="15.0">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="Sistem za glasanje">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="createElectionButton" text="+ Novo Glasanje" onAction="#handleOpenCreateElectionModal" style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" visible="false" />
            </HBox>

            <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                <tabs>
                    <!-- TAB 1: AKTIVNA GLASANJA -->
                    <Tab fx:id="activeTab" text="Aktivna glasanja">
                        <content>
                            <VBox spacing="10.0">
                                <padding>
                                    <Insets top="10.0" />
                                </padding>
                                <TableView fx:id="activeElectionsTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="activeTitleColumn" text="Naziv glasanja" prefWidth="280.0"/>
                                        <TableColumn fx:id="activeStatusColumn" text="Status" prefWidth="150.0"/>
                                        <TableColumn fx:id="activeActionColumn" text="Akcija" prefWidth="180.0"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>
                        </content>
                    </Tab>

                    <!-- TAB 2: ZAVRŠENA GLASANJA / REZULTATI -->
                    <Tab fx:id="finishedTab" text="Rezultati / Završena glasanja">
                        <content>
                            <VBox spacing="10.0">
                                <padding>
                                    <Insets top="10.0" />
                                </padding>
                                <TableView fx:id="finishedElectionsTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="finishedTitleColumn" text="Naziv glasanja" prefWidth="280.0"/>
                                        <TableColumn fx:id="finishedStatusColumn" text="Status" prefWidth="150.0"/>
                                        <TableColumn fx:id="finishedActionColumn" text="Akcija" prefWidth="180.0"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>
                        </content>
                    </Tab>
                </tabs>
            </TabPane>
        </VBox>
    </center>
</BorderPane>